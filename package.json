{
  "name": "@elastic/copilot-cowork-plugin",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-package.ts",
    "pretest": "npm run build",
    "package": "npm run build && atk validate --manifest-file ./appPackage/manifest.json && atk package --manifest-file ./appPackage/manifest.json --output-package-file ./appPackage/build/appPackage.dev.zip --output-folder ./appPackage/build",
    "test": "node --experimental-vm-modules --no-warnings node_modules/.bin/jest",
    "lint": "eslint . && prettier --check . && node scripts/check-license-headers.ts",
    "format": "prettier --write . && node scripts/check-license-headers.ts --fix"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
