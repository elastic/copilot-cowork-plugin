{
  "name": "@elastic/copilot-cowork-plugin",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-package.ts",
    "pretest": "npm run build",
    "package": "npm run build && atk package --manifest-file ./appPackage/manifest.json --output-package-file ./appPackage/build/appPackage.dev.zip --output-folder ./appPackage/build",
    "test": "node --experimental-vm-modules --no-warnings node_modules/.bin/jest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "yaml": "^2.7.1"
  }
}
